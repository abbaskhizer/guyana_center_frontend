<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust user-installed CAs for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific configuration for your server IP - allow self-signed certs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">185.197.194.139</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
